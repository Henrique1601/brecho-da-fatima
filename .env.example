# Supabase (opcional — sem essas variáveis o app usa localStorage automaticamente)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Gemini API (para geração automática de títulos, descrições e tags)
GEMINI_API_KEY=

# Buffer (opcional — para agendamento/publicação em redes sociais)
BUFFER_ACCESS_TOKEN=
